# Copy to .env and fill in Cloudflare Realtime TURN credentials.
# Start with npm run start:local (Node.js 20.6+).
# Never put these long-lived secrets in public/ or client code.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Set true only to test that audio really passes through TURN.
# Leave false for direct connections with TURN as fallback.
VOICE_RELAY_ONLY=false
